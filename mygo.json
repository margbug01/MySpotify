{
  "name": "MySpotify",
  "identifier": "dev.margbug.vinyl",
  "slug": "vinyl",
  "version": "0.4.23",
  "out": "build.noindex",
  "resources": ["LICENSE", "licenses", "scripts/install-linux-webview.sh"],
  "macos": {
    "icon": "AppIcon.icon",
    "infoPlist": {
      "CFBundleDevelopmentRegion": "zh_CN",
      "CFBundleLocalizations": ["zh-Hans", "en", "it"],
      "NSLocalNetworkUsageDescription": "在「播放设备」里找到同一网络中的 Google Cast 音箱。",
      "NSBonjourServices": ["_googlecast._tcp"]
    }
  },
  "linux": {
    "comment": "Spotify desktop client (experimental Linux support)",
    "categories": ["AudioVideo", "Audio", "Player"],
    "command": "vinyl",
    "webview": true
  },
  "updates": {
    "publicKey": "PpF+fvU7GVBIY9OAsE64fhYTEJtDccZyBk692dRZWCc=",
    "github": "margbug01/MySpotify",
    "changelog": "CHANGELOG.md"
  }
}
